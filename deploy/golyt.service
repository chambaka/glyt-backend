[Unit]
Description=GoLyt luggage storage and transfer API
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=root
Group=root
WorkingDirectory=/opt/apps/golyt

# Layout on the server:
#   /opt/apps/golyt/golyt.jar
#   /opt/apps/golyt/lib/
#   /opt/apps/golyt/application.yml
#   /opt/apps/golyt/logs/
# Thin jar manifest includes Main-Class + Class-Path: lib/...
ExecStart=/usr/bin/java -jar /opt/apps/golyt/golyt.jar --spring.config.additional-location=optional:file:/opt/apps/golyt/

SuccessExitStatus=143
Restart=always
RestartSec=10
TimeoutStopSec=60

StandardOutput=journal
StandardError=journal
SyslogIdentifier=golyt

[Install]
WantedBy=multi-user.target
